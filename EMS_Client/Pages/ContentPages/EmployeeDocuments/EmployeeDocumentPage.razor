@page "/EmployeeDocumentPage"

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-5 mb-5">
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">Employee Documents</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddCircleOutline"
                           Class="mt-2 mr-2"
                           @onclick="() => OpenDialogAsync(new EmployeeDocument())">
                    Add Document
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudTable Items="@EmployeeDocuments" Hover="true" Striped="true" FixedHeader="true" Height="525px" Elevation="0">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Id</MudTh>
                    <MudTh>Employee</MudTh>
                    <MudTh>FileName</MudTh>
                    <MudTh>FilePath</MudTh>
                    <MudTh>Category</MudTh>
                    <MudTh>UploadedAt</MudTh>
                    <MudTh>ExpiryDate</MudTh>
                    <MudTh>Uploader</MudTh>
                    <MudTh>CreatedAt</MudTh>
                    <MudTh>Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#">@(EmployeeDocuments.IndexOf(context) + 1)</MudTd>
                    <MudTd DataLabel="Id">@context.Id</MudTd>
                    <MudTd DataLabel="Employee">@context.Employee.FirstName @context.Employee.LastName</MudTd>
                    <MudTd DataLabel="FileName">@context.FileName</MudTd>
                    <MudTd DataLabel="FilePath">@context.FilePath</MudTd>
                    <MudTd DataLabel="Category">@context.Category</MudTd>
                    <MudTd DataLabel="UploadedAt">@context.UploadedAt</MudTd>
                    <MudTd DataLabel="ExpiryDate">@context.ExpiryDate</MudTd>
                    @if (context.Uploader != null)
                    {
                        <MudTd DataLabel="Uploader">@context.Employee.FirstName @context.Employee.LastName</MudTd>
                    }
                    else
                    {
                        <MudTd DataLabel="Manager">N/A</MudTd>
                    }
                    <MudTd DataLabel="CreatedAt">@context.CreatedAt</MudTd>
                    <MudTd DataLabel="Action">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => EditClicked(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteClicked(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Center">No Country Added Yet!</MudAlert>
                </NoRecordsContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    public List<EmployeeDocument> EmployeeDocuments { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        EmployeeDocuments = await employeeDocumentService.GetAll(Constants.EmployeeDocumentBaseUrl);
    }

    private async Task OpenDialogAsync(EmployeeDocument? employeeDocument = null)
    {
        var parameters = new DialogParameters();

        if (employeeDocument != null)
            parameters["model"] = employeeDocument;

        var dialog = await DialogService.ShowAsync<EmployeeDocumentDialog>("Employee Document Dialog", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            EmployeeDocuments = await employeeDocumentService.GetAll(Constants.EmployeeDocumentBaseUrl);
            StateHasChanged();
        }
    }

    //Delete
    private async Task DeleteClicked(EmployeeDocument obj)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
                                "Confirm Delete",
                                $"Are you sure you wanna delete {obj.EmployeeId}?",
                                yesText: "Delete",
                                cancelText: "Cancel");

        if (result == null || !result.Value)
            return;

        var response = await employeeDocumentService.DeleteById(obj.Id, Constants.EmployeeDocumentBaseUrl);
        if (response.Flag)
        {
            Snackbar.Add("Deleted Successfuly!", Severity.Success); ;
            EmployeeDocuments = await employeeDocumentService.GetAll(Constants.EmployeeDocumentBaseUrl);
            StateHasChanged();
        }
    }

    //Edit
    private async Task EditClicked(EmployeeDocument obj)
    {
        await OpenDialogAsync(obj);
    }
}

@page "/AttendancePage"

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-5 mb-5">
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">Attendance</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddCircleOutline"
                           Class="mt-2 mr-2"
                           @onclick="() => OpenDialogAsync(new Attendance())">
                    Add Attendance
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudTable Items="@Attendances" Hover="true" Striped="true" FixedHeader="true" Height="525px" Elevation="0">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Id</MudTh>
                    <MudTh>Employee</MudTh>
                    <MudTh>CheckIn</MudTh>
                    <MudTh>CheckOut</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>CreatedAt</MudTh>
                    <MudTh>Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#">@(Attendances.IndexOf(context) + 1)</MudTd>
                    <MudTd DataLabel="Id">@context.Id</MudTd>
                    <MudTd DataLabel="Employee">@context.Employee.FirstName @context.Employee.LastName</MudTd>
                    <MudTd DataLabel="CheckIn">@context.CheckIn</MudTd>
                    <MudTd DataLabel="CheckOut">@context.CheckOut</MudTd>
                    <MudTd DataLabel="Status">@context.Status</MudTd>
                    <MudTd DataLabel="CreatedAt">@context.CreatedAt</MudTd>
                    <MudTd DataLabel="Action">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => EditClicked(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteClicked(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Center">No Attendance Added Yet!</MudAlert>
                </NoRecordsContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    public List<Attendance> Attendances { get; set; } = new();
    public List<Employee> Employees { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Attendances = await attendanceService.GetAll(Constants.AttendanceBaseUrl);
        Employees = await employeeService.GetAll(Constants.EmployeeBaseUrl);
    }

    private async Task OpenDialogAsync(Attendance? attendance = null)
    {
        var parameters = new DialogParameters();

        if (attendance != null)
            parameters["model"] = attendance;

        var dialog = await DialogService.ShowAsync<AttendanceDialog>("Attendance Dialog", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            Attendances = await attendanceService.GetAll(Constants.AttendanceBaseUrl);
            StateHasChanged();
        }
    }

    //Delete
    private async Task DeleteClicked(Attendance obj)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
                                "Confirm Delete",
                                $"Are you sure you wanna delete {obj.EmployeeId}?",
                                yesText: "Delete",
                                cancelText: "Cancel");

        if (result == null || !result.Value)
            return;

        var response = await attendanceService.DeleteById(obj.Id, Constants.AttendanceBaseUrl);
        if (response.Flag)
        {
            Snackbar.Add("Deleted Successfuly!", Severity.Success); ;
            Attendances = await attendanceService.GetAll(Constants.AttendanceBaseUrl);
            StateHasChanged();
        }
    }

    //Edit
    private async Task EditClicked(Attendance obj)
    {
        await OpenDialogAsync(obj);
    }
}

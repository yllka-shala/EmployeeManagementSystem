@page "/EmployeeAssetsPage"

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-5 mb-5">
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">Employee Assets</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddCircleOutline"
                           Class="mt-2 mr-2"
                           @onclick="() => OpenDialogAsync(new EmployeeAsset())">
                    Add Employee Assets
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudTable Items="@EmployeeAssets" Hover="true" Striped="true" FixedHeader="true" Height="525px" Elevation="0">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Id</MudTh>
                    <MudTh>Employee</MudTh>
                    <MudTh>Asset</MudTh>
                    <MudTh>Assigned Date</MudTh>
                    <MudTh>Returned Date</MudTh>
                    <MudTh>CreatedAt</MudTh>
                    <MudTh>Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#">@(EmployeeAssets.IndexOf(context) + 1)</MudTd>
                    <MudTd DataLabel="Id">@context.Id</MudTd>
                    <MudTd DataLabel="Employee">@context.Employee.FirstName @context.Employee.LastName</MudTd>
                    <MudTd DataLabel="Asset">@context.Asset.Name</MudTd>
                    <MudTd DataLabel="Assigned Date">@context.AssignedDate</MudTd>
                    <MudTd DataLabel="Returned Date">@context.ReturnedDate</MudTd>
                    <MudTd DataLabel="CreatedAt">@context.CreatedAt</MudTd>
                    <MudTd DataLabel="Action">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => EditClicked(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteClicked(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Center">No Employee Assets Added Yet!</MudAlert>
                </NoRecordsContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    public List<EmployeeAsset> EmployeeAssets { get; set; } = new();
    public List<Asset> Assets { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        EmployeeAssets = await employeeAssetService.GetAll(Constants.EmployeeAssetBaseUrl);
        Assets = await assetService.GetAll(Constants.AssetBaseUrl);
    }

    private async Task OpenDialogAsync(EmployeeAsset? employeeAsset = null)
    {
        var parameters = new DialogParameters();

        if (employeeAsset != null)
            parameters["model"] = employeeAsset;

        var dialog = await DialogService.ShowAsync<EmployeeAssetsDialog>("Employee Assets Dialog", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            EmployeeAssets = await employeeAssetService.GetAll(Constants.EmployeeAssetBaseUrl);
            StateHasChanged();
        }
    }

    //Delete
    private async Task DeleteClicked(EmployeeAsset obj)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
                                "Confirm Delete",
                                $"Are you sure you wanna delete {obj.EmployeeId}?",
                                yesText: "Delete",
                                cancelText: "Cancel");

        if (result == null || !result.Value)
            return;

        var response = await employeeAssetService.DeleteById(obj.Id, Constants.EmployeeAssetBaseUrl);
        if (response.Flag)
        {
            Snackbar.Add("Deleted Successfuly!", Severity.Success); ;
            EmployeeAssets = await employeeAssetService.GetAll(Constants.EmployeeAssetBaseUrl);
            StateHasChanged();
        }
    }

    //Edit
    private async Task EditClicked(EmployeeAsset obj)
    {
        await OpenDialogAsync(obj);
    }
}

@page "/AssetPage"

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-5 mb-5">
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">Asset</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddCircleOutline"
                           Class="mt-2 mr-2"
                           @onclick="() => OpenDialogAsync(new Asset())">
                    Add Asset
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudTable Items="@AssetsList" Hover="true" Striped="true" FixedHeader="true" Height="525px" Elevation="0">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Id</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>AssetTag</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>PurchaseDate</MudTh>
                    <MudTh>Value</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>CreatedAt</MudTh>
                    <MudTh>Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#">@(AssetsList.IndexOf(context) + 1)</MudTd>
                    <MudTd DataLabel="Id">@context.Id</MudTd>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="AssetTag">@context.AssetTag</MudTd>
                    <MudTd DataLabel="Description">@context.Description</MudTd>
                    <MudTd DataLabel="PurchaseDate">@context.PurchaseDate</MudTd>
                    <MudTd DataLabel="Value">@context.Value</MudTd>
                    <MudTd DataLabel="Status">@context.Status</MudTd>
                    <MudTd DataLabel="CreatedAt">@context.CreatedAt</MudTd>
                    <MudTd DataLabel="Action">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => EditClicked(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteClicked(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Center">No Asset Added Yet!</MudAlert>
                </NoRecordsContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    public List<Asset> AssetsList { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        AssetsList = await assetService.GetAll(Constants.AssetBaseUrl);
    }

    private async Task OpenDialogAsync(Asset? asset = null)
    {
        var parameters = new DialogParameters();

        if (asset != null)
            parameters["model"] = asset;

        var dialog = await DialogService.ShowAsync<AssetDialog>("Asset Dialog", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            AssetsList = await assetService.GetAll(Constants.AssetBaseUrl);
            StateHasChanged();
        }
    }

    //Delete
    private async Task DeleteClicked(Asset obj)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
                                "Confirm Delete",
                                $"Are you sure you wanna delete {obj.Name}?",
                                yesText: "Delete",
                                cancelText: "Cancel");

        if (result == null || !result.Value)
            return;

        var response = await assetService.DeleteById(obj.Id, Constants.AssetBaseUrl);
        if (response.Flag)
        {
            Snackbar.Add("Deleted Successfuly!", Severity.Success); ;
            AssetsList = await assetService.GetAll(Constants.AssetBaseUrl);
            StateHasChanged();
        }
    }

    //Edit
    private async Task EditClicked(Asset obj)
    {
        await OpenDialogAsync(obj);
    }
}

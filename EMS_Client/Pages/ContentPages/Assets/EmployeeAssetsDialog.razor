<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Align="Align.Left" Color="Color.Primary">Employee Assets</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <MudCard Elevation="0">

                <MudCardContent>
                    <MudSelect T="int?" @bind-Value="model.EmployeeId" Label="Employee" Variant="Variant.Outlined" Clearable Placeholder="Select">
                        @foreach (var item in _Employees)
                        {
                            <MudSelectItem T="int?" Value="@item.Id">@item.FirstName @item.LastName</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int?" @bind-Value="model.AssetId" Label="Asset" Variant="Variant.Outlined" Clearable Placeholder="Select">
                        @foreach (var item in _Assets)
                        {
                            <MudSelectItem T="int?" Value="@item.Id">@item.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudDatePicker Label="AssignedDate" @bind-Date="model.AssignedDate" Variant="Variant.Outlined" Clearable="true"
                                   For="@(() => model.AssignedDate)" ShowToolbar="false" />

                    <MudDatePicker Label="ReturnedDate" @bind-Date="model.ReturnedDate" Variant="Variant.Outlined" Clearable="true"
                                   For="@(() => model.ReturnedDate)" ShowToolbar="false" />
                </MudCardContent>

                <MudCardActions Class="justify-end">
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary">Save</MudButton>
                </MudCardActions>
            </MudCard>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public EmployeeAsset model { get; set; } = new();

    public List<Employee> _Employees = new List<Employee>();
    public List<Asset> _Assets = new List<Asset>();

    protected override async Task OnInitializedAsync()
    {
        _Employees = await employeeService.GetAll(Constants.EmployeeBaseUrl);
        _Assets = await assetService.GetAll(Constants.AssetBaseUrl);
        StateHasChanged();
    }

    private async Task OnValidSubmit(EditContext context)
    {
        await HandleSaveOperationEvent(model);

        MudDialog.Close(DialogResult.Ok(true));
    }

    private bool DisplayMessage(bool flag)
    {
        if (flag)
        {
            Snackbar.Add("Registration Successful!", Severity.Success); ;
            return true;
        }
        else
        {
            Snackbar.Add("Something went wrong.", Severity.Error);
            return false;
        }
    }

    //Insert and Update
    private async Task HandleSaveOperationEvent(EmployeeAsset obj)
    {
        bool successCheck = false;
        if (obj.Id > 0)
        {
            var result = await employeeAssetService.Update(obj, Constants.EmployeeAssetBaseUrl);
            successCheck = DisplayMessage(result.Flag);
        }
        else
        {
            var result = await employeeAssetService.Insert(obj, Constants.EmployeeAssetBaseUrl);
            successCheck = DisplayMessage(result.Flag);
        }
    }
}

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Align="Align.Left" Color="Color.Primary">Leave Request</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <MudCard Elevation="0">

                <MudCardContent>
                    <MudSelect T="int?" @bind-Value="model.EmployeeId" Label="Employee" Variant="Variant.Outlined" Clearable Placeholder="Select">
                        @foreach (var item in _Employees)
                        {
                            <MudSelectItem T="int?" Value="@item.Id">@item.FirstName @item.LastName</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int?" @bind-Value="model.LeaveTypeId" Label="LeaveType" Variant="Variant.Outlined" Clearable Placeholder="Select">
                        @foreach (var item in _LeaveTypes)
                        {
                            <MudSelectItem T="int?" Value="@item.Id">@item.Name</MudSelectItem>
                        }
                    </MudSelect>
                   
                    <MudDatePicker Label="StartDate" @bind-Date="model.StartDate" Variant="Variant.Outlined" Clearable="true"
                                   For="@(() => model.StartDate)" ShowToolbar="false" />

                    <MudDatePicker Label="EndDate" @bind-Date="model.EndDate" Variant="Variant.Outlined" Clearable="true"
                                   For="@(() => model.EndDate)" ShowToolbar="false" />

                    <MudTextField T="string" Label="Reason" Variant="Variant.Outlined"
                                  @bind-Value="model.Reason" For="@(() => model.Reason)"
                                  InputType="InputType.Text" Class="mt-2" />

                    <MudSelect @bind-Value="model.Status" Label="Status" Variant="Variant.Outlined">
                        @foreach (var status in Enum.GetValues(typeof(LeaveStatus)).Cast<LeaveStatus>())
                        {
                            <MudSelectItem Value="status">@status</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int?" @bind-Value="model.ApprovedBy" Label="Approver" Variant="Variant.Outlined" Clearable Placeholder="Select">
                        @foreach (var item in _Approver)
                        {
                            <MudSelectItem T="int?" Value="@item.Id">@item.FirstName @item.LastName</MudSelectItem>
                        }
                    </MudSelect>

                </MudCardContent>

                <MudCardActions Class="justify-end">
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary">Save</MudButton>
                </MudCardActions>
            </MudCard>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public LeaveRequest model { get; set; } = new();

    public List<Employee> _Employees = new List<Employee>();
    public List<Employee> _Approver = new List<Employee>();
    public List<LeaveType> _LeaveTypes = new List<LeaveType>();
    private LeaveStatus _status;

    protected override async Task OnInitializedAsync()
    {
        _Employees = await employeeService.GetAll(Constants.EmployeeBaseUrl);
        _Approver = await employeeService.GetAll(Constants.EmployeeBaseUrl);
        _LeaveTypes = await leaveTypeService.GetAll(Constants.LeaveTypeBaseUrl);

        StateHasChanged();
    }

    private async Task OnValidSubmit(EditContext context)
    {
        await HandleSaveOperationEvent(model);

        MudDialog.Close(DialogResult.Ok(true));
    }

    private bool DisplayMessage(bool flag)
    {
        if (flag)
        {
            Snackbar.Add("Registration Successful!", Severity.Success); ;
            return true;
        }
        else
        {
            Snackbar.Add("Something went wrong.", Severity.Error);
            return false;
        }
    }

    //Insert and Update
    private async Task HandleSaveOperationEvent(LeaveRequest obj)
    {
        bool successCheck = false;
        if (obj.Id > 0)
        {
            var result = await leaveRequestService.Update(obj, Constants.LeaveRequestBaseUrl);
            successCheck = DisplayMessage(result.Flag);
        }
        else
        {
            var result = await leaveRequestService.Insert(obj, Constants.LeaveRequestBaseUrl);
            successCheck = DisplayMessage(result.Flag);
        }
    }
}

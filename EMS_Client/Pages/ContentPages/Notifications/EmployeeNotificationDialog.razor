<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Align="Align.Left" Color="Color.Primary">Employee Notification</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <MudCard Elevation="0">

                <MudCardContent>
                    <MudSelect T="int?" @bind-Value="model.EmployeeId" Label="Employee" Variant="Variant.Outlined" Clearable Placeholder="Select">
                        @foreach (var item in _Employees)
                        {
                            <MudSelectItem T="int?" Value="@item.Id">@item.FirstName @item.LastName</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int?" @bind-Value="model.NotificationId" Label="Notification" Variant="Variant.Outlined" Clearable Placeholder="Select">
                        @foreach (var item in _Notifications)
                        {
                            <MudSelectItem T="int?" Value="@item.Id">@item.Title</MudSelectItem>
                        }
                    </MudSelect>

                    <MudCheckBox @bind-Value="model.IsRead" Label="Is Read"></MudCheckBox>

                    <MudDatePicker Label="ReadAt" @bind-Date="model.ReadAt" Variant="Variant.Outlined" Clearable="true"
                                   For="@(() => model.ReadAt)" ShowToolbar="false" />


                </MudCardContent>

                <MudCardActions Class="justify-end">
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary">Save</MudButton>
                </MudCardActions>
            </MudCard>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public EmployeeNotification model { get; set; } = new();

    public List<Employee> _Employees = new List<Employee>();
    public List<Notification> _Notifications = new List<Notification>();

    protected override async Task OnInitializedAsync()
    {
        _Employees = await employeeService.GetAll(Constants.EmployeeBaseUrl);
        _Notifications = await notificationService.GetAll(Constants.NotificationBaseUrl);
        StateHasChanged();
    }

    private async Task OnValidSubmit(EditContext context)
    {
        await HandleSaveOperationEvent(model);

        MudDialog.Close(DialogResult.Ok(true));
    }

    private bool DisplayMessage(bool flag)
    {
        if (flag)
        {
            Snackbar.Add("Registration Successful!", Severity.Success); ;
            return true;
        }
        else
        {
            Snackbar.Add("Something went wrong.", Severity.Error);
            return false;
        }
    }

    //Insert and Update
    private async Task HandleSaveOperationEvent(EmployeeNotification obj)
    {
        bool successCheck = false;
        if (obj.Id > 0)
        {
            var result = await employeeNotificationService.Update(obj, Constants.EmployeeNotificationBaseUrl);
            successCheck = DisplayMessage(result.Flag);
        }
        else
        {
            var result = await employeeNotificationService.Insert(obj, Constants.EmployeeNotificationBaseUrl);
            successCheck = DisplayMessage(result.Flag);
        }
    }
}

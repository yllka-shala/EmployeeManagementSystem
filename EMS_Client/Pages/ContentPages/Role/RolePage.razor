@page "/RolePage"

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-5 mb-5">
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">Role</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddCircleOutline"
                           Class="mt-2 mr-2"
                           @onclick="() => OpenDialogAsync(new Roles())">
                    Add Role
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudTable Items="@_Roles" Hover="true" Striped="true" FixedHeader="true" Height="525px" Elevation="0">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Id</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>CreatedAt</MudTh>
                    <MudTh>Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#">@(_Roles.IndexOf(context) + 1)</MudTd>
                    <MudTd DataLabel="Id">@context.Id</MudTd>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Description">@context.Description</MudTd>
                    <MudTd DataLabel="CreatedAt">@context.CreatedAt</MudTd>
                    <MudTd DataLabel="Action">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => EditClicked(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteClicked(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Center">No Role Added Yet!</MudAlert>
                </NoRecordsContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    public List<Roles> _Roles { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _Roles = await rolesService.GetAll(Constants.RoleBaseUrl);
    }

    private async Task OpenDialogAsync(Roles? role = null)
    {
        var parameters = new DialogParameters();

        if (role != null)
            parameters["model"] = role;

        var dialog = await DialogService.ShowAsync<RoleDialog>("Role Dialog", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            _Roles = await rolesService.GetAll(Constants.RoleBaseUrl);
            StateHasChanged();
        }
    }

    //Delete
    private async Task DeleteClicked(Roles obj)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
                                "Confirm Delete",
                                $"Are you sure you wanna delete {obj.Name}?",
                                yesText: "Delete",
                                cancelText: "Cancel");

        if (result == null || !result.Value)
            return;

        var response = await rolesService.DeleteById(obj.Id, Constants.RoleBaseUrl);
        if (response.Flag)
        {
            Snackbar.Add("Deleted Successfuly!", Severity.Success); ;
            _Roles = await rolesService.GetAll(Constants.RoleBaseUrl);
            StateHasChanged();
        }
    }

    //Edit
    private async Task EditClicked(Roles obj)
    {
        await OpenDialogAsync(obj);
    }
}
